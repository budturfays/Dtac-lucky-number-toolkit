rules_version = '2';

// Public catalog is read-only for everyone; favorites are private per user.
service cloud.firestore {
  match /databases/{database}/documents {

    // The number catalog (msisdn -> {price, grade, sum, pools})
    match /numbers/{msisdn} {
      allow read: if true;
      allow write: if false; // only import via admin SDK
    }

    // Per-user favorites
    match /favorites/{uid}/items/{msisdn} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
